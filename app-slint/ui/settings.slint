import { ListView, ScrollView } from "std-widgets.slint";
import {
    Theme, GroupRowUi, PhraseRowUi, PetCardUi, GroupIcon, IconButton,
    PrimaryButton, GhostButton, InputArea, SegmentedPair, SegmentedRow, ToggleSwitch, GalleryCardUi
} from "common.slint";

/// 宠物库卡片:缩略图 + 名称 + 状态按钮;已安装的点击即切换
component GalleryCard inherits Rectangle {
    in property <GalleryCardUi> card;
    callback clicked;
    width: 130px;
    height: 124px;
    border-radius: 12px;
    border-width: card.status == 3 ? 2px : 1px;
    border-color: card.status == 3 ? Theme.accent : (gc-ta.has-hover ? #cbd5e1 : #e2e8f0);
    background: card.status == 3 ? #fff7ed : #ffffff;
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 8px;
                background: card.thumb.width > 0 ? transparent : #f1f5f9;
                Image { source: card.thumb; width: 56px; height: 56px; image-fit: contain; }
            }
        }
        Text {
            text: card.name;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            color: Theme.text-primary;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: st.preferred-width + 20px;
                height: 22px;
                border-radius: 11px;
                background: card.status == 0 ? (gc-ta.has-hover ? #ea580c : Theme.accent)
                    : card.status == 2 ? (gc-ta.has-hover ? #e2e8f0 : #f1f5f9)
                    : transparent;
                st := Text {
                    text: card.status == 0 ? "安装" : card.status == 1 ? "安装中…" : card.status == 2 ? "使用" : "使用中";
                    font-size: 11.5px;
                    font-weight: 600;
                    color: card.status == 0 ? #ffffff : card.status == 3 ? Theme.accent : Theme.text-secondary;
                }
            }
        }
    }
    gc-ta := TouchArea {
        enabled: card.status == 0 || card.status == 2;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// 宠物卡(网格内复用;err 非空 = 不可选,半透明展示错误)
component PetCard inherits Rectangle {
    in property <PetCardUi> pet;
    callback clicked;
    callback delete-clicked;
    width: 118px;
    height: 132px;
    border-radius: 12px;
    border-width: 2px;
    border-color: pet.selected ? Theme.accent : (pet-ta.has-hover && pet.err == "" ? #cbd5e1 : #e2e8f0);
    background: pet.selected ? #fff7ed : #ffffff;
    opacity: pet.err != "" ? 0.55 : 1.0;
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        alignment: center;
        // thumb 已是 Rust 侧预裁好的单帧,无需 source-clip
        if pet.err == "": Image {
            source: pet.thumb;
            width: 72px;
            height: 78px;
            image-fit: contain;
        }
        Text {
            text: pet.name;
            font-size: 12px;
            font-weight: 600;
            horizontal-alignment: center;
            color: Theme.text-primary;
            overflow: elide;
        }
        if pet.err != "": Text {
            text: pet.err;
            font-size: 10.5px;
            color: Theme.danger;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    pet-ta := TouchArea {
        enabled: pet.err == "";
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // 删除入口常显在右上角(淡色,悬停变红),放在 pet-ta 之后才能盖住它接收点击
    if pet.removable: Rectangle {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: del-ta.has-hover ? #fef2f2 : transparent;
        Image {
            source: @image-url("icons/trash-2.svg");
            colorize: del-ta.has-hover ? Theme.danger : Theme.text-placeholder;
            width: 13px;
            height: 13px;
        }
        del-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.delete-clicked(); }
        }
    }
}

export component SettingsWindow inherits Window {
    in property <[GroupRowUi]> groups;
    in property <[PhraseRowUi]> phrases;
    in property <[PetCardUi]> pets;
    in property <string> group-name;
    in property <int> group-icon-idx;
    in property <bool> has-group;
    in property <bool> solid-theme;
    in property <int> pet-size-idx: 2; // 0小 1中 2大
    in-out property <bool> autostart-on;
    in property <string> custom-dir;
    in property <string> data-msg;
    // 错误消息红色高亮(导入失败/保存失败等),普通消息保持灰
    in property <bool> data-msg-error;
    // 面板按使用频率排序
    in-out property <bool> sort-by-use;
    callback sort-toggled(bool);
    // 单槽删除撤销(短语),8s 内有效
    in property <bool> can-undo;
    callback undo-delete;

    // 关于与更新
    in property <string> app-version;
    in property <string> update-msg;
    in property <bool> update-msg-error;
    in property <bool> update-available;
    in property <bool> update-busy;
    in-out property <bool> auto-check-on;
    callback check-update;
    callback do-update;
    callback auto-check-toggled(bool);

    // 确认框(泛化:kind 0=危险删除 1=导入替换,动作文案随场景)
    in-out property <bool> confirm-visible: false;
    in property <string> confirm-title;
    in property <string> confirm-msg;
    in property <int> confirm-kind: 0;
    in property <string> confirm-action-label: "删除";
    callback confirm-ok;

    callback group-selected(int);
    callback group-add;
    callback group-renamed(string);
    callback group-icon-set(int);
    callback group-delete;
    callback group-dropped(int, int); // from, to(拖拽落点)
    callback phrase-add(string);
    callback phrase-edited(int, string);
    callback phrase-delete(int);
    callback phrase-dropped(int, int);
    callback pet-selected(int);
    callback pet-delete(int);
    callback theme-toggled(bool); // true=solid
    callback pet-size-changed(int);
    callback autostart-toggled(bool);
    callback pick-dir;
    callback clear-dir;
    callback do-export;
    callback do-import;
    callback dismiss-msg;

    in-out property <int> editing-idx: -1;
    // 0 常用语 / 1 桌宠 / 2 通用
    in-out property <int> page: 0;
    // 分组图标选择浮层
    in-out property <bool> icon-picker-open: false;
    // 桌宠页:0 已安装 / 1 发现更多(在线宠物库)
    in-out property <int> pet-view: 0;
    in property <[GalleryCardUi]> gallery-cards;
    in property <string> gallery-status;
    in property <string> gallery-page-label;
    in-out property <string> gallery-query;
    callback gallery-open;
    callback gallery-search(string);
    callback gallery-page(int);
    callback gallery-install(int);
    // 分组名编辑态;切换/新建/删除分组时由 Rust refresh_settings 强制复位
    in-out property <bool> renaming: false;

    // 拖拽排序状态
    in-out property <int> drag-group: -1;
    in-out property <length> drag-group-dy: 0;
    in-out property <bool> drag-group-done: false;
    in-out property <int> drag-phrase: -1;
    in-out property <length> drag-phrase-dy: 0;

    title: "PetPhrase 设置";
    icon: @image-url("icon.png");
    default-font-family: "Microsoft YaHei UI";
    width: 780px;
    height: 560px;
    background: #f8fafc;
    default-font-size: 13px;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // ---- 顶部页签 ----
        Rectangle {
            height: 42px;
            background: #ffffff;
            HorizontalLayout {
                padding-left: 16px;
                padding-top: 6px;
                spacing: 4px;
                alignment: start;
                for label[i] in ["常用语", "桌宠", "通用"]: Rectangle {
                    width: pt.preferred-width + 32px;
                    pt := Text {
                        text: label;
                        font-size: 13px;
                        font-weight: root.page == i ? 600 : 400;
                        color: root.page == i ? Theme.accent : Theme.text-muted;
                    }
                    Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        width: parent.width - 16px;
                        x: 8px;
                        background: root.page == i ? Theme.accent : transparent;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.page = i; }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: #e2e8f0; }
        }

        // ================= 常用语页 =================
        if root.page == 0: HorizontalLayout {
            padding: 0;
            spacing: 0;

            // 左栏分组(长按拖动排序)
            Rectangle {
                width: 200px;
                background: #ffffff;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Rectangle {
                        vertical-stretch: 1;
                        glist := ListView {
                        width: 100%;
                        height: 100%;
                        for g[i] in root.groups: Rectangle {
                            height: 40px;
                            grow := Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                border-width: root.drag-group == i ? 2px : 1px;
                                border-color: root.drag-group == i ? Theme.accent
                                    : g.selected ? #f9731650 : transparent;
                                background: root.drag-group == i ? #fff7ed
                                    : g.selected ? Theme.accent-soft
                                    : grow-ta.has-hover ? #f1f5f9 : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: center;
                                        GroupIcon {
                                            idx: g.icon-idx;
                                            tint: g.selected ? Theme.accent : Theme.text-muted;
                                        }
                                    }
                                    Text {
                                        text: g.name;
                                        color: g.selected ? Theme.text-primary : Theme.text-secondary;
                                        font-weight: g.selected ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: g.count;
                                        color: Theme.text-placeholder;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                                grow-ta := TouchArea {
                                    mouse-cursor: root.drag-group == i ? grabbing : pointer;
                                    moved => {
                                        if (self.pressed && (root.drag-group == i || Math.abs(self.mouse-y / 1px - self.pressed-y / 1px) > 8)) {
                                            root.drag-group = i;
                                            root.drag-group-dy = self.mouse-y - self.pressed-y;
                                        }
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.up && root.drag-group == i) {
                                            root.group-dropped(i, i + Math.round((self.mouse-y - self.pressed-y) / 40px));
                                            root.drag-group = -1;
                                            root.drag-group-done = true;
                                        }
                                    }
                                    clicked => {
                                        if (root.drag-group-done) {
                                            root.drag-group-done = false;
                                        } else {
                                            root.group-selected(i);
                                        }
                                    }
                                }
                            }
                        }
                        }
                        // 拖拽插入指示线(只重绘这一条线,零卡顿)
                        if root.drag-group >= 0: Rectangle {
                            x: 2px;
                            width: parent.width - 4px;
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                            y: Math.clamp(
                                (Math.clamp(root.drag-group + Math.round(root.drag-group-dy / 40px) + (root.drag-group-dy > 0 ? 1 : 0), 0, root.groups.length) * 40px) + glist.viewport-y,
                                0px, parent.height - 3px);
                        }
                    }
                    GhostButton {
                        text: "+ 新建分组";
                        clicked => { root.group-add(); }
                    }
                }
                Rectangle { x: parent.width - 1px; width: 1px; background: #e2e8f0; }
            }

            // 右栏
            VerticalLayout {
                padding: 0;
                spacing: 0;
                horizontal-stretch: 1;

                // 分组头:图标(点击弹出选择)+ 大号内联改名 + 幽灵删除
                Rectangle {
                    height: 56px;
                    background: #ffffff;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 16px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 8px;
                                background: root.icon-picker-open ? Theme.accent-soft : (gi-ta.has-hover ? #f1f5f9 : transparent);
                                animate background { duration: 150ms; }
                                GroupIcon {
                                    idx: root.group-icon-idx;
                                    width: 18px;
                                    height: 18px;
                                    tint: Theme.accent;
                                }
                                gi-ta := TouchArea {
                                    enabled: root.has-group;
                                    mouse-cursor: pointer;
                                    clicked => { root.icon-picker-open = !root.icon-picker-open; }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            // 分组名两态:显示态(Text 绑定,悬停出铅笔)/ 编辑态(TextInput + 下划线)。
                            // 不能让 TextInput 常驻绑定 group-name:用户一打字绑定即被拆,之后永不跟随
                            Rectangle {
                                width: 240px;
                                height: 32px;

                                // ---- 显示态 ----
                                HorizontalLayout {
                                    visible: !root.renaming;
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: root.group-name;
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("icons/pencil.svg");
                                            colorize: name-ta.has-hover ? Theme.text-secondary : Theme.text-placeholder;
                                            width: 13px;
                                            height: 13px;
                                            // 常显淡色铅笔作可改名提示,悬停加深
                                            opacity: !root.has-group ? 0 : (name-ta.has-hover ? 1 : 0.55);
                                            animate opacity { duration: 150ms; }
                                        }
                                    }
                                }
                                name-ta := TouchArea {
                                    visible: !root.renaming;
                                    enabled: root.has-group;
                                    mouse-cursor: text;
                                    clicked => {
                                        rename-input.text = root.group-name;
                                        root.renaming = true;
                                        rename-input.focus();
                                        // 全选:直接打字即整体替换,免去手动移光标删旧名
                                        rename-input.select-all();
                                    }
                                }

                                // ---- 编辑态 ----
                                rename-input := TextInput {
                                    visible: root.renaming;
                                    enabled: root.renaming;
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    single-line: true;
                                    vertical-alignment: center;
                                    accepted => {
                                        if (root.renaming) {
                                            root.renaming = false;
                                            root.group-renamed(self.text);
                                        }
                                        self.clear-focus();
                                    }
                                    key-pressed(event) => {
                                        if (event.text == Key.Escape) {
                                            root.renaming = false; // 先退编辑态,失焦提交才会跳过
                                            self.clear-focus();
                                            return accept;
                                        }
                                        reject
                                    }
                                    changed has-focus => {
                                        if (root.renaming && !self.has-focus) {
                                            root.renaming = false;
                                            root.group-renamed(self.text);
                                        }
                                    }
                                }
                                Rectangle {
                                    visible: root.renaming;
                                    y: parent.height - 2px;
                                    height: 2px;
                                    background: Theme.accent;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.can-undo: VerticalLayout {
                            alignment: center;
                            GhostButton {
                                text: "撤销删除";
                                clicked => { root.undo-delete(); }
                            }
                        }
                        if root.has-group: VerticalLayout {
                            alignment: center;
                            GhostButton {
                                text: "删除分组";
                                danger: true;
                                icon: @image-url("icons/trash-2.svg");
                                clicked => { root.group-delete(); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: #e2e8f0; }
                }

                // 短语列表(拖动手柄/长按行体排序,插入线指示落点)
                Rectangle {
                    vertical-stretch: 1;
                    plist := ListView {
                    width: 100%;
                    height: 100%;
                    for p[i] in root.phrases: Rectangle {
                        property <bool> editing: root.editing-idx == i;
                        height: editing ? 132px : 52px;
                        prow := Rectangle {
                            x: 16px;
                            width: parent.width - 32px;
                            y: 4px;
                            height: parent.height - 8px;
                            border-radius: 8px;
                            border-width: root.drag-phrase == i ? 2px : 1px;
                            border-color: editing || root.drag-phrase == i ? Theme.accent : #e2e8f0;
                            background: root.drag-phrase == i ? #fff7ed : #ffffff;
                            clip: true;

                            if !editing: HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 6px;
                                Text {
                                    text: p.display;
                                    color: Theme.text-primary;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                // 拖动手柄:按住直接拖
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: grip-ta.has-hover || root.drag-phrase == i ? #f1f5f9 : transparent;
                                        Image {
                                            source: @image-url("icons/grip-vertical.svg");
                                            colorize: Theme.text-placeholder;
                                            width: 14px;
                                            height: 14px;
                                        }
                                        grip-ta := TouchArea {
                                            mouse-cursor: root.drag-phrase == i ? grabbing : grab;
                                            moved => {
                                                if (self.pressed) {
                                                    root.drag-phrase = i;
                                                    root.drag-phrase-dy = self.mouse-y - self.pressed-y;
                                                }
                                            }
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.up && root.drag-phrase == i) {
                                                    root.phrase-dropped(i, i + Math.round((self.mouse-y - self.pressed-y) / 52px));
                                                    root.drag-phrase = -1;
                                                }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: @image-url("icons/pencil.svg");
                                        clicked => { root.editing-idx = i; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: @image-url("icons/trash-2.svg");
                                        tint: Theme.danger;
                                        clicked => { root.phrase-delete(i); }
                                    }
                                }
                            }

                            if editing: VerticalLayout {
                                padding: 8px;
                                spacing: 6px;
                                edit-area := InputArea {
                                    text: p.text;
                                    vertical-stretch: 1;
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    spacing: 6px;
                                    GhostButton { text: "取消"; clicked => { root.editing-idx = -1; } }
                                    PrimaryButton {
                                        text: "保存";
                                        clicked => {
                                            root.phrase-edited(i, edit-area.text);
                                            root.editing-idx = -1;
                                        }
                                    }
                                }
                            }

                            if !editing: TouchArea {
                                // 行体长按拖拽(与手柄二选一均可);右侧 116px 留给手柄/编辑/删除
                                width: Math.max(0px, parent.width - 116px);
                                moved => {
                                    if (self.pressed && (root.drag-phrase == i || Math.abs(self.mouse-y / 1px - self.pressed-y / 1px) > 10)) {
                                        root.drag-phrase = i;
                                        root.drag-phrase-dy = self.mouse-y - self.pressed-y;
                                    }
                                }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.up && root.drag-phrase == i) {
                                        root.phrase-dropped(i, i + Math.round((self.mouse-y - self.pressed-y) / 52px));
                                        root.drag-phrase = -1;
                                    }
                                }
                            }
                        }
                    }
                    }
                    // 拖拽插入指示线
                    if root.drag-phrase >= 0: Rectangle {
                        x: 16px;
                        width: parent.width - 32px;
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        y: Math.clamp(
                            (Math.clamp(root.drag-phrase + Math.round(root.drag-phrase-dy / 52px) + (root.drag-phrase-dy > 0 ? 1 : 0), 0, root.phrases.length) * 52px) + plist.viewport-y,
                            0px, parent.height - 3px);
                    }
                    // 跟手幽灵条:拖到哪条随到哪(单个小元素,零卡顿)
                    if root.drag-phrase >= 0: Rectangle {
                        x: 24px;
                        width: parent.width - 48px;
                        height: 40px;
                        border-radius: 8px;
                        background: #fff7ed;
                        border-width: 1.5px;
                        border-color: Theme.accent;
                        clip: true;
                        y: Math.clamp(
                            root.drag-phrase * 52px + root.drag-phrase-dy + plist.viewport-y + 6px,
                            0px, parent.height - 40px);
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 100%;
                            text: root.phrases[root.drag-phrase].display;
                            color: Theme.text-primary;
                            font-size: 12.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // 添加区
                Rectangle {
                    height: 96px;
                    background: #ffffff;
                    Rectangle { height: 1px; background: #e2e8f0; }
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 10px;
                        new-phrase := InputArea {
                            horizontal-stretch: 1;
                            placeholder: "输入新常用语,可多行…";
                        }
                        VerticalLayout {
                            alignment: center; // 与输入框垂直居中对齐
                            PrimaryButton {
                                text: "添加";
                                enabled: root.has-group;
                                clicked => {
                                    root.phrase-add(new-phrase.text);
                                    new-phrase.text = "";
                                }
                            }
                        }
                    }
                }
            }
        }

        // ================= 桌宠页 =================
        // 已安装 / 发现更多 是「选宠」的两个来源,同页切换
        if root.page == 1: VerticalLayout {
            vertical-stretch: 1;
            padding: 24px;
            padding-bottom: 0;
            spacing: 12px;

            HorizontalLayout {
                spacing: 12px;
                SegmentedPair {
                    width: 240px;
                    left-label: "已安装 (" + root.pets.length + ")";
                    right-label: "发现更多";
                    right-selected: root.pet-view == 1;
                    changed(r) => {
                        root.pet-view = r ? 1 : 0;
                        if (r) { root.gallery-open(); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "大小"; color: Theme.text-muted; font-size: 12.5px; vertical-alignment: center; }
                SegmentedRow {
                    width: 168px;
                    labels: ["小", "中", "大"];
                    selected: root.pet-size-idx;
                    changed(i) => { root.pet-size-changed(i); }
                }
            }

            // ---- 已安装 ----
            if root.pet-view == 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    padding-bottom: 24px;
                    alignment: start;
                    Text {
                        text: "兼容 petdex 格式,扫描内置、~/.petdex/pets、~/.codex/pets 与自定义目录。";
                        font-size: 12px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                    // 宠物多行网格:每行 5 张(780 窗宽 - 48 padding 下第 6 张会截断)
                    for rowidx in Math.ceil(root.pets.length / 5): HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        for colidx in Math.min(5, root.pets.length - rowidx * 5): PetCard {
                            pet: root.pets[rowidx * 5 + colidx];
                            clicked => { root.pet-selected(rowidx * 5 + colidx); }
                            delete-clicked => { root.pet-delete(rowidx * 5 + colidx); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        GhostButton {
                            text: root.custom-dir == "" ? "从文件夹添加宠物…" : "更换自定义目录…";
                            icon: @image-url("icons/folder.svg");
                            clicked => { root.pick-dir(); }
                        }
                        if root.custom-dir != "": GhostButton {
                            text: "移除";
                            clicked => { root.clear-dir(); }
                        }
                        Text {
                            text: root.custom-dir;
                            font-size: 12px;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // ---- 发现更多(petdex 在线宠物库) ----
            if root.pet-view == 1: VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 260px;
                        height: 32px;
                        border-radius: 8px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: gq.has-focus ? Theme.accent : #e2e8f0;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Image { source: @image-url("icons/search.svg"); colorize: Theme.text-placeholder; width: 14px; height: 14px; }
                            }
                            Rectangle {
                                clip: true;
                                gq := TextInput {
                                    text <=> root.gallery-query;
                                    single-line: true;
                                    vertical-alignment: center;
                                    font-size: 12.5px;
                                    color: Theme.text-primary;
                                    changed text => { root.gallery-search(self.text); }
                                }
                                // 聚焦即隐藏:中文输入法组字期间 text 仍为空,占位会与组字文字重叠
                                if gq.text == "" && !gq.has-focus: Text {
                                    text: "搜索宠物名…";
                                    color: Theme.text-placeholder;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: root.gallery-status;
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    // 分页放搜索行右侧:三行卡片已占满窗高,放底部会被挤出可视区
                    GhostButton {
                        text: "‹";
                        clicked => { root.gallery-page(-1); }
                    }
                    Text { text: root.gallery-page-label; color: Theme.text-secondary; font-size: 12.5px; vertical-alignment: center; }
                    GhostButton {
                        text: "›";
                        clicked => { root.gallery-page(1); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        alignment: start;
                        for rowidx in Math.ceil(root.gallery-cards.length / 5): HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            for colidx in Math.min(5, root.gallery-cards.length - rowidx * 5): GalleryCard {
                                card: root.gallery-cards[rowidx * 5 + colidx];
                                clicked => { root.gallery-install(rowidx * 5 + colidx); }
                            }
                        }
                    }
                }
            }
        }

        // ================= 通用页 =================
        if root.page == 2: ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 10px;
                alignment: start;

                Text { text: "关于与更新"; font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Text {
                        text: "当前版本 v" + root.app-version;
                        font-size: 12.5px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    if !root.update-available: GhostButton {
                        text: "检查更新";
                        enabled: !root.update-busy;
                        clicked => { root.check-update(); }
                    }
                    if root.update-available: PrimaryButton {
                        text: "立即更新";
                        enabled: !root.update-busy;
                        clicked => { root.do-update(); }
                    }
                    Text {
                        text: root.update-msg;
                        font-size: 12px;
                        color: root.update-msg-error ? Theme.danger : Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                Rectangle { height: 8px; }
                Text { text: "面板主题"; font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                SegmentedPair {
                    left-label: "亚克力磨砂";
                    right-label: "实底浅色";
                    right-selected: root.solid-theme;
                    changed(solid) => { root.theme-toggled(solid); }
                }

                Rectangle { height: 8px; }
                Text { text: "行为"; font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    ToggleSwitch {
                        on: root.autostart-on;
                        toggled(v) => {
                            root.autostart-on = v;
                            root.autostart-toggled(v);
                        }
                    }
                    Text { text: "开机自动启动"; vertical-alignment: center; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    ToggleSwitch {
                        on: root.sort-by-use;
                        toggled(v) => {
                            root.sort-by-use = v;
                            root.sort-toggled(v);
                        }
                    }
                    Text { text: "面板按使用频率排序(常用的排前面)"; vertical-alignment: center; color: Theme.text-secondary; }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    ToggleSwitch {
                        on: root.auto-check-on;
                        toggled(v) => {
                            root.auto-check-on = v;
                            root.auto-check-toggled(v);
                        }
                    }
                    Text { text: "自动检查更新"; vertical-alignment: center; color: Theme.text-secondary; }
                }

                Rectangle { height: 8px; }
                Text { text: "数据"; font-size: 14px; font-weight: 600; color: Theme.text-primary; }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    GhostButton { text: "导出常用语…"; icon: @image-url("icons/download.svg"); clicked => { root.do-export(); } }
                    GhostButton { text: "导入常用语…"; icon: @image-url("icons/upload.svg"); clicked => { root.do-import(); } }
                }
            }
        }
    }

    // ---- 分组图标选择浮层(点分组头图标打开,点外面关) ----
    if root.icon-picker-open: Rectangle {
        TouchArea { clicked => { root.icon-picker-open = false; } }
        Rectangle {
            x: 208px;
            y: 42px + 50px;
            width: 6 * 32px + 5 * 4px + 16px;
            height: 2 * 32px + 4px + 16px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 10px;
            drop-shadow-blur: 24px;
            drop-shadow-color: #0f172a2e;
            TouchArea { } // 挡穿透
            for icon-i in 12: Rectangle {
                x: 8px + Math.mod(icon-i, 6) * 36px;
                y: 8px + Math.floor(icon-i / 6) * 36px;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: root.group-icon-idx == icon-i ? Theme.accent-soft : (ic-ta.has-hover ? #f1f5f9 : transparent);
                GroupIcon {
                    idx: icon-i;
                    tint: root.group-icon-idx == icon-i ? Theme.accent : Theme.text-muted;
                }
                ic-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.icon-picker-open = false;
                        root.group-icon-set(icon-i);
                    }
                }
            }
        }
    }

    // ---- 全局消息条(所有页可见;以前只在「数据」区显示,常用语页的报错用户看不到) ----
    if root.data-msg != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16px;
        width: Math.min(msg-text.preferred-width + 48px, parent.width - 48px);
        height: 36px;
        border-radius: 8px;
        background: root.data-msg-error ? #fef2f2 : #1e293b;
        border-width: root.data-msg-error ? 1px : 0;
        border-color: Theme.danger;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0f172a33;
        msg-text := Text {
            text: root.data-msg;
            font-size: 12.5px;
            color: root.data-msg-error ? Theme.danger : #ffffff;
            overflow: elide;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.dismiss-msg(); }
        }
    }

    // ---- 应用内确认框 ----
    if root.confirm-visible: Rectangle {
        background: #0f172a73;
        TouchArea { clicked => { root.confirm-visible = false; } }
        Rectangle {
            width: 320px;
            height: confirm-col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-radius: 14px;
            drop-shadow-blur: 40px;
            drop-shadow-color: #0f172a47;
            TouchArea { } // 挡穿透
            confirm-col := VerticalLayout {
                padding: 20px;
                spacing: 8px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: root.confirm-kind == 1 ? #fff7ed : #fef2f2;
                        Image {
                            source: root.confirm-kind == 1
                                ? @image-url("icons/upload.svg")
                                : @image-url("icons/trash-2.svg");
                            colorize: root.confirm-kind == 1 ? Theme.accent : Theme.danger;
                            width: 20px;
                            height: 20px;
                        }
                    }
                }
                Text {
                    text: root.confirm-title;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Theme.text-primary;
                }
                Text {
                    text: root.confirm-msg;
                    font-size: 12.5px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    GhostButton {
                        text: "取消";
                        clicked => { root.confirm-visible = false; }
                    }
                    Rectangle {
                        width: 96px;
                        height: 34px;
                        border-radius: 8px;
                        background: del-ta.has-hover
                            ? (root.confirm-kind == 1 ? #ea580c : #b91c1c)
                            : (root.confirm-kind == 1 ? Theme.accent : Theme.danger);
                        animate background { duration: 150ms; }
                        Text { text: root.confirm-action-label; color: #ffffff; font-weight: 600; }
                        del-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.confirm-visible = false;
                                root.confirm-ok();
                            }
                        }
                    }
                }
            }
        }
    }
}
